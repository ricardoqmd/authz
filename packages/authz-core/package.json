{
  "name": "@ricardoqmd/authz-core",
  "version": "0.2.0",
  "description": "Framework-agnostic authorization primitives: permission menus, batched decisions and a fail-closed session that holds them",
  "keywords": [
    "authorization",
    "authz",
    "abac",
    "permissions",
    "policy-decision-point",
    "state-machine"
  ],
  "author": "ricardoqmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardoqmd/authz.git",
    "directory": "packages/authz-core"
  },
  "homepage": "https://github.com/ricardoqmd/authz/tree/main/packages/authz-core",
  "bugs": "https://github.com/ricardoqmd/authz/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
